{
  "count_up": {
    "invariant": "s.x <= n",
    "variant": "n - s.x",
    "solver": "omega"
  },
  "count_down": {
    "invariant": "s.x <= n",
    "variant": "s.x",
    "solver": "omega"
  },
  "transfer": {
    "invariant": "s.x + s.y == n + m",
    "variant": "s.y",
    "solver": "omega"
  },
  "double_count": {
    "invariant": "s.x <= n and s.y == 2 * s.x",
    "variant": "n - s.x",
    "solver": "omega"
  },
  "stride_two": {
    "invariant": "s.x <= n + 1",
    "variant": "n - s.x",
    "solver": "omega"
  },
  "parity_down": {
    "invariant": "s.x <= n and s.x % 2 == n % 2",
    "variant": "s.x",
    "solver": "omega"
  },
  "synchronized": {
    "invariant": "s.x + m == s.y + n and s.x <= n and s.y <= m",
    "variant": "s.x + s.y",
    "solver": "omega"
  },
  "bounded_copy": {
    "invariant": "s.x + s.y == n and s.x <= m",
    "variant": "s.y",
    "solver": "omega"
  },
  "two_phase": {
    "invariant": "s.x + s.y + s.z == n + m",
    "variant": "s.x + s.y",
    "solver": "omega"
  },
  "multiply": {
    "invariant": "s.x <= n and s.y == s.x * m",
    "variant": "n - s.x",
    "solver": "nonlinear"
  },
  "triangular": {
    "invariant": "s.x <= n and 2 * s.y == s.x * (s.x + 1)",
    "variant": "n - s.x",
    "solver": "nonlinear"
  },
  "square": {
    "invariant": "s.x <= n and s.y == s.x * s.x",
    "variant": "n - s.x",
    "solver": "nonlinear"
  }
}
