import Mathlib.Tactic

/-!
# An imperative language and a total-correctness VC generator

The state type is a parameter, so programs use typed record fields as
registers and arrays. Primitive actions and tests are partial: `none`
denotes a fault. Loop invariants and natural-number variants are ghost
annotations; execution never consults them.
-/

universe u

namespace MiniVerify

abbrev Assertion (σ : Type u) := σ → Prop

/-- A typed embedded imperative language. All runtime effects appear in
partial primitive state transitions, allowing bounds errors to be
represented explicitly. -/
inductive Cmd (σ : Type u) where
  | skip : Cmd σ
  | action (step : σ → Option σ) : Cmd σ
  | seq (first second : Cmd σ) : Cmd σ
  | ite (test : σ → Option Bool) (yes no : Cmd σ) : Cmd σ
  | whileLoop (test : σ → Option Bool) (invariant : Assertion σ)
      (rank : σ → Nat) (body : Cmd σ) : Cmd σ
  /-- The invariant may mention an immutable snapshot of the state at
  loop entry, supplied as its first argument. -/
  | whileLocal (test : σ → Option Bool) (invariant : σ → σ → Prop)
      (rank : σ → Nat) (body : Cmd σ) : Cmd σ

/-- Normal big-step execution. Every primitive and test on the executed
path must succeed; invariant and rank annotations have no runtime role. -/
inductive Exec : Cmd σ → σ → σ → Prop where
  | skip : Exec .skip s s
  | action (hstep : step s = some t) : Exec (.action step) s t
  | seq (hfirst : Exec first s m) (hsecond : Exec second m t) :
      Exec (.seq first second) s t
  | ite_true (htest : test s = some true) (hyes : Exec yes s t) :
      Exec (.ite test yes no) s t
  | ite_false (htest : test s = some false) (hno : Exec no s t) :
      Exec (.ite test yes no) s t
  | while_false (htest : test s = some false) :
      Exec (.whileLoop test invariant rank body) s s
  | while_true (htest : test s = some true) (hbody : Exec body s m)
      (hrest : Exec (.whileLoop test invariant rank body) m t) :
      Exec (.whileLoop test invariant rank body) s t
  | whileLocal_false (htest : test s = some false) :
      Exec (.whileLocal test invariant rank body) s s
  | whileLocal_true (htest : test s = some true) (hbody : Exec body s m)
      (hrest : Exec (.whileLocal test invariant rank body) m t) :
      Exec (.whileLocal test invariant rank body) s t

/-- Structural verification-condition generation. For a loop the
generated formula requires its invariant initially, safe testing,
the postcondition on exit, and invariant preservation with a strictly
decreasing natural-number variant on every body execution.

This is a generator of logical obligations, not a decision procedure
for arbitrary predicates. Nested loop obligations are generated by the
same recursion. -/
def vcgen : Cmd σ → Assertion σ → Assertion σ
  | .skip, post => post
  | .action step, post => fun s => ∃ t, step s = some t ∧ post t
  | .seq first second, post => vcgen first (vcgen second post)
  | .ite test yes no, post => fun s =>
      match test s with
      | none => False
      | some true => vcgen yes post s
      | some false => vcgen no post s
  | .whileLoop test invariant rank body, post => fun s =>
      invariant s ∧ ∀ t, invariant t →
        match test t with
        | none => False
        | some false => post t
        | some true => vcgen body (fun t' => invariant t' ∧ rank t' < rank t) t
  | .whileLocal test invariant rank body, post => fun s =>
      invariant s s ∧ ∀ t, invariant s t →
        match test t with
        | none => False
        | some false => post t
        | some true => vcgen body (fun t' => invariant s t' ∧ rank t' < rank t) t

/-- Main soundness theorem: proved VCs imply actual finite normal
execution satisfying the postcondition, for every program and state. -/
theorem vcgen_sound (c : Cmd σ) (post : Assertion σ) (s : σ)
    (hvc : vcgen c post s) : ∃ t, Exec c s t ∧ post t := by
  induction c generalizing post s with
  | skip => exact ⟨s, .skip, hvc⟩
  | action step =>
      obtain ⟨t, hstep, ht⟩ := hvc
      exact ⟨t, .action hstep, ht⟩
  | seq first second ihfirst ihsecond =>
      obtain ⟨m, hm, hvm⟩ := ihfirst (vcgen second post) s hvc
      obtain ⟨t, ht, hpost⟩ := ihsecond post m hvm
      exact ⟨t, .seq hm ht, hpost⟩
  | ite test yes no ihyes ihno =>
      cases he : test s with
      | none => simp [vcgen, he] at hvc
      | some b =>
          cases b with
          | false =>
              have hv : vcgen no post s := by simpa [vcgen, he] using hvc
              obtain ⟨t, ht, hp⟩ := ihno post s hv
              exact ⟨t, .ite_false he ht, hp⟩
          | true =>
              have hv : vcgen yes post s := by simpa [vcgen, he] using hvc
              obtain ⟨t, ht, hp⟩ := ihyes post s hv
              exact ⟨t, .ite_true he ht, hp⟩
  | whileLoop test invariant rank body ihbody =>
      obtain ⟨hs, hstep⟩ := hvc
      have hloop : ∀ n : Nat, ∀ a : σ, rank a = n → invariant a →
          ∃ t, Exec (.whileLoop test invariant rank body) a t ∧ post t := by
        intro n
        induction n using Nat.strong_induction_on with
        | h n ih =>
            intro a hn ha
            have hv := hstep a ha
            cases he : test a with
            | none => simp [he] at hv
            | some b =>
                cases b with
                | false =>
                    exact ⟨a, .while_false he, by simpa [he] using hv⟩
                | true =>
                    have hb : vcgen body
                        (fun a' => invariant a' ∧ rank a' < rank a) a := by
                      simpa [he] using hv
                    obtain ⟨m, hm, hmi, hmr⟩ := ihbody _ a hb
                    obtain ⟨t, ht, hp⟩ := ih (rank m) (by omega) m rfl hmi
                    exact ⟨t, .while_true he hm ht, hp⟩
      exact hloop (rank s) s rfl hs
  | whileLocal test invariant rank body ihbody =>
      obtain ⟨hs, hstep⟩ := hvc
      have hloop : ∀ n : Nat, ∀ a : σ, rank a = n → invariant s a →
          ∃ t, Exec (.whileLocal test invariant rank body) a t ∧ post t := by
        intro n
        induction n using Nat.strong_induction_on with
        | h n ih =>
            intro a hn ha
            have hv := hstep a ha
            cases he : test a with
            | none => simp [he] at hv
            | some b =>
                cases b with
                | false => exact ⟨a, .whileLocal_false he, by simpa [he] using hv⟩
                | true =>
                    have hb : vcgen body
                        (fun a' => invariant s a' ∧ rank a' < rank a) a := by
                      simpa [he] using hv
                    obtain ⟨m, hm, hmi, hmr⟩ := ihbody _ a hb
                    obtain ⟨t, ht, hp⟩ := ih (rank m) (by omega) m rfl hmi
                    exact ⟨t, .whileLocal_true he hm ht, hp⟩
      exact hloop (rank s) s rfl hs

/-- Hoare-style total correctness for an entire set of initial states. -/
def TotalCorrect (pre : Assertion σ) (c : Cmd σ) (post : Assertion σ) : Prop :=
  ∀ s, pre s → ∃ t, Exec c s t ∧ post t

theorem totalCorrect_of_vcs (pre : Assertion σ) (c : Cmd σ) (post : Assertion σ)
    (hvcs : ∀ s, pre s → vcgen c post s) : TotalCorrect pre c post :=
  fun s hs => vcgen_sound c post s (hvcs s hs)

end MiniVerify
